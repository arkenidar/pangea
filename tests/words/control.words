#!/usr/bin/env pangea

define_word "square" 1 {
    return multiply @1 @1
}
print square 5

define_word "first3" 0 {
    i= 1
    while not greater $i 20 {
        if equal 0 modulus $i 3 {
            break $i
        }
        i= add $i 1
    }
}
print first3

define_word "sum_odds" 1 {
    i= 0
    total= 0
    while greater @1 $i {
        i= add $i 1
        if equal 0 modulus $i 2 {
            continue
        } {
            total= add $total $i
        }
    }
    return $total
}
print sum_odds 10

print nil
