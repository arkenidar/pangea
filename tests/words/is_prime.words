define_word "is_divisible" 2
    equal 0 modulus @1 @2

define_word "is_prime" 1 {
    n= @1
    if not greater $n 1 {
        return false
    } {
        pass
    }
    i= 2
    while not greater multiply $i $i $n {
        if is_divisible $n $i {
            return false
        } {
            pass
        }
        i= add $i 1
    }
    return true
}

print is_prime 2
print is_prime 17
print is_prime 20
