#!/usr/bin/env pangea-italian

definisci_parola "divisibile" 2
    uguale 0 modulo @1 @2

definisci_parola "primo" 1 {
    n= @1
    se non maggiore $n 1 {
        ritorna falso
    } {
        passa
    }
    i= 2
    mentre non maggiore moltiplica $i $i $n {
        se divisibile $n $i {
            ritorna falso
        } {
            passa
        }
        i= somma $i 1
    }
    ritorna vero
}

stampa primo 2
stampa primo 17
stampa primo 20
