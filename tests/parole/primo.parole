#!/usr/bin/env pangea-italian

# verifica numero primo (con ritorno anticipato)

definisci_parola "divisibile" 2
    uguale 0 modulo @1 @2

definisci_parola "primo" 1 {
    n= @1
    se non maggiore $n 1 {
        ritorna falso  # n <= 1 non e primo
    } {
        passa
    }
    i= 2
    mentre non maggiore moltiplica $i $i $n {  # divisione fino a sqrt(n)
        se divisibile $n $i {
            ritorna falso  # trovato un divisore
        } {
            passa
        }
        i= somma $i 1
    }
    ritorna vero  # nessun divisore trovato
}

stampa primo 2
stampa primo 17
stampa primo 20
