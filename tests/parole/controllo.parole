#!/usr/bin/env pangea-italian

definisci_parola "quadrato" 1 {
    ritorna moltiplica @1 @1
}
stampa quadrato 5

definisci_parola "primo3" 0 {
    i= 1
    mentre non maggiore $i 20 {
        se uguale 0 modulo $i 3 {
            interrompi $i
        }
        i= somma $i 1
    }
}
stampa primo3

definisci_parola "somma_dispari" 1 {
    i= 0
    totale= 0
    mentre maggiore @1 $i {
        i= somma $i 1
        se uguale 0 modulo $i 2 {
            continua
        } {
            totale= somma $totale $i
        }
    }
    ritorna $totale
}
stampa somma_dispari 10

stampa nullo
